#!/usr/bin/env bash
set -Eeuo pipefail

action="${1:-status}"

wpctl_status() {
  local out volume
  out="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
  [[ -n "$out" ]] || return 1
  volume="$(awk '{printf "%.0f", $2 * 100}' <<<"$out")"
  [[ "$volume" =~ ^[0-9]+$ ]] || return 1
  if [[ "$out" == *MUTED* ]]; then
    printf 'AUDIO MUTE %s%%\n' "$volume"
  else
    printf 'AUDIO %s%%\n' "$volume"
  fi
}

pactl_status() {
  local muted volume
  muted="$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}' || true)"
  volume="$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | sed -n 's/.* \([0-9][0-9]*%\) .*/\1/p' | head -n1)"
  [[ -n "$volume" ]] || return 1
  if [[ "$muted" == yes ]]; then
    printf 'AUDIO MUTE %s\n' "$volume"
  else
    printf 'AUDIO %s\n' "$volume"
  fi
}

if command -v wpctl >/dev/null 2>&1; then
  case "$action" in
    status) wpctl_status ;;
    up)     wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    down)   wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    mute)   wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    *) printf 'Usage: kalipwm-audio {status|up|down|mute}\n' >&2; exit 2 ;;
  esac
  exit $?
fi

if command -v pactl >/dev/null 2>&1; then
  case "$action" in
    status) pactl_status ;;
    up)     pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
    down)   pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
    mute)   pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
    *) printf 'Usage: kalipwm-audio {status|up|down|mute}\n' >&2; exit 2 ;;
  esac
  exit $?
fi

if [[ "$action" == status ]]; then
  printf 'AUDIO unavailable\n'
  exit 0
fi

printf 'No supported PipeWire/PulseAudio control utility was found.\n' >&2
exit 1
