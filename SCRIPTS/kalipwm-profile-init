#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
DETECTOR="${KALIPWM_DETECTOR:-$SCRIPT_DIR/kalipwm-detect}"
PROFILE_PATH="${KALIPWM_PROFILE_PATH:-$HOME/.config/kalipwm/profile.conf}"
MODE=print
FORCE=false

usage() {
  cat <<'EOF'
Usage: kalipwm-profile-init [--print|--write] [--force]

Generate a KaliPWM hardware profile from the read-only detector.

  --print   Print the generated profile only (default; no files changed)
  --write   Write the profile to ~/.config/kalipwm/profile.conf
  --force   Allow --write to replace an existing profile
  -h, --help

The generated profile is shell-safe and contains detection data plus conservative
operator defaults. Existing profiles are preserved unless --force is explicit.
EOF
}

while (($#)); do
  case "$1" in
    --print) MODE=print ;;
    --write) MODE=write ;;
    --force) FORCE=true ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

[[ -x "$DETECTOR" || -f "$DETECTOR" ]] || {
  printf 'Detector not found: %s\n' "$DETECTOR" >&2
  exit 1
}

# Defaults are deliberately conservative. Desktop behavior is inherited from
# the known-good upstream baseline and is not changed by this profile.
declare -A detected=(
  [environment]=unknown
  [vendor]=unknown
  [product]=unknown
  [battery]=none
  [adapter]=none
  [backlight]=none
  [wifi_interface]=none
  [wired_interface]=none
  [internal_display]=none
  [connected_displays]=none
  [nvidia_runtime]=none
)

while IFS='=' read -r key value; do
  case "$key" in
    environment|vendor|product|battery|adapter|backlight|wifi_interface|wired_interface|internal_display|connected_displays|nvidia_runtime)
      detected["$key"]="$value"
      ;;
  esac
done < <(bash "$DETECTOR")

emit_assignment() {
  local key="$1" value="$2"
  printf '%s=%q\n' "$key" "$value"
}

generate_profile() {
  printf '# Generated by KaliPWM V1 rebuild. Safe to edit.\n'
  printf '# Desktop behavior remains inherited from the known-good upstream baseline.\n'
  printf 'profile_schema=1\n'
  emit_assignment environment "${detected[environment]}"
  emit_assignment vendor "${detected[vendor]}"
  emit_assignment product "${detected[product]}"
  emit_assignment battery "${detected[battery]}"
  emit_assignment adapter "${detected[adapter]}"
  emit_assignment backlight "${detected[backlight]}"
  emit_assignment wifi_interface "${detected[wifi_interface]}"
  emit_assignment wired_interface "${detected[wired_interface]}"
  emit_assignment internal_display "${detected[internal_display]}"
  emit_assignment connected_displays "${detected[connected_displays]}"
  emit_assignment nvidia_runtime "${detected[nvidia_runtime]}"
  printf 'external_position=right\n'
  printf 'editor=vim\n'
  printf 'cat_override=false\n'
  printf 'screenshots=scrot\n'
  printf 'telemetry=false\n'
  printf 'plymouth=false\n'
}

if [[ "$MODE" == print ]]; then
  generate_profile
  exit 0
fi

if [[ -e "$PROFILE_PATH" && "$FORCE" != true ]]; then
  printf '[+] Existing profile preserved: %s\n' "$PROFILE_PATH"
  printf '[*] Use --force only when replacement is intentional.\n'
  exit 0
fi

profile_dir="$(dirname -- "$PROFILE_PATH")"
mkdir -p "$profile_dir"
tmp="$(mktemp "$profile_dir/.profile.conf.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

generate_profile > "$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$PROFILE_PATH"
trap - EXIT

printf '[+] Profile written: %s\n' "$PROFILE_PATH"
