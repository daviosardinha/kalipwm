#!/usr/bin/env bash
set -u

OK_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0
INFO_COUNT=0

print_status() {
    local level="$1"
    shift

    case "$level" in
        OK)   ((OK_COUNT+=1)) ;;
        WARN) ((WARN_COUNT+=1)) ;;
        FAIL) ((FAIL_COUNT+=1)) ;;
        INFO) ((INFO_COUNT+=1)) ;;
    esac

    printf '[%-4s] %s\n' "$level" "$*"
}

section() {
    printf '\n%s\n' "$1"
}

have() {
    command -v "$1" >/dev/null 2>&1
}

process_running() {
    pgrep -x "$1" >/dev/null 2>&1
}

check_command_process() {
    local label="$1"
    local command_name="$2"
    local process_name="$3"

    if ! have "$command_name"; then
        print_status FAIL "$label is not installed"
    elif process_running "$process_name"; then
        print_status OK "$label is installed and running"
    else
        print_status WARN "$label is installed but not running"
    fi
}

check_helper() {
    local name="$1"
    local expected_target="$2"
    local managed_path="/usr/bin/$name"
    local managed_resolved=""
    local path_command=""
    local path_resolved=""

    if [ ! -e "$managed_path" ] && [ ! -L "$managed_path" ]; then
        print_status FAIL "Managed $name helper is missing: $managed_path"
    elif [ ! -x "$managed_path" ]; then
        print_status FAIL "Managed $name helper is not executable: $managed_path"
    else
        managed_resolved="$(readlink -f "$managed_path" 2>/dev/null || printf '%s' "$managed_path")"
        if [ -n "$expected_target" ] && [ "$managed_resolved" != "$expected_target" ]; then
            print_status WARN "Managed $name helper resolves to $managed_resolved (expected $expected_target)"
        else
            print_status OK "Managed $name helper: $managed_path -> $managed_resolved"
        fi
    fi

    path_command="$(type -P "$name" 2>/dev/null || true)"
    if [ -z "$path_command" ]; then
        print_status WARN "$name is not available through PATH"
        return
    fi

    path_resolved="$(readlink -f "$path_command" 2>/dev/null || printf '%s' "$path_command")"
    if [ "$path_command" != "$managed_path" ]; then
        print_status WARN "$name is shadowed in PATH by $path_command -> $path_resolved"
    fi
}

virtualization_type() {
    local virt=""

    if have systemd-detect-virt; then
        virt="$(systemd-detect-virt 2>/dev/null || true)"
    fi

    if [ -z "$virt" ] || [ "$virt" = "none" ]; then
        if [ -r /sys/class/dmi/id/product_name ]; then
            case "$(/usr/bin/cat /sys/class/dmi/id/product_name 2>/dev/null)" in
                *VMware*) virt="vmware" ;;
                *VirtualBox*) virt="oracle" ;;
                *KVM*|*QEMU*) virt="kvm" ;;
                *) virt="none" ;;
            esac
        else
            virt="none"
        fi
    fi

    printf '%s' "$virt"
}

font_available() {
    local pattern="$1"

    have fc-list || return 1
    fc-list : family 2>/dev/null | grep -qi "$pattern"
}

find_wifi_interface() {
    local path iface

    for path in /sys/class/net/*; do
        iface="${path##*/}"
        [ "$iface" = "lo" ] && continue
        if [ -d "$path/wireless" ]; then
            printf '%s' "$iface"
            return 0
        fi
    done

    if have iw; then
        iface="$(iw dev 2>/dev/null | awk '$1 == "Interface" {print $2; exit}')"
        if [ -n "$iface" ]; then
            printf '%s' "$iface"
            return 0
        fi
    fi

    return 1
}

find_vpn_interface() {
    ip -o link show 2>/dev/null |
        awk -F': ' '$2 ~ /^(tun[0-9]*|tap[0-9]*|wg[0-9]*|ppp[0-9]*)$/ {print $2; exit}'
}

run_doctor() {
    local virt session display_name resolution default_if default_ip wifi_if vpn_if
    local os_name target_file choice_file current_wallpaper_file bspwmrc gpu_name fan_file
    local batteries=()

    virt="$(virtualization_type)"
    session="${XDG_SESSION_TYPE:-unknown}"
    target_file="${XDG_CACHE_HOME:-$HOME/.cache}/kalipwm/target"
    choice_file="${XDG_CACHE_HOME:-$HOME/.cache}/kalipwm/wallpaper-choice"
    current_wallpaper_file="${XDG_CACHE_HOME:-$HOME/.cache}/kalipwm/current-wallpaper"
    bspwmrc="$HOME/.config/bspwm/bspwmrc"

    printf 'KaliPWM Obsidian Doctor\n'
    printf 'Read-only diagnostic report\n'

    section "System"
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        os_name="${PRETTY_NAME:-${NAME:-Unknown Linux}}"
        if [ "${ID:-}" = "kali" ] || [[ "$os_name" == *Kali* ]]; then
            print_status OK "$os_name"
        else
            print_status WARN "$os_name (Kali Linux expected)"
        fi
    else
        print_status WARN "Unable to read /etc/os-release"
    fi

    if [ "$session" = "x11" ] || [ -n "${DISPLAY:-}" ]; then
        print_status OK "X11 session detected${DISPLAY:+ on $DISPLAY}"
    else
        print_status WARN "X11 session not detected (session type: $session)"
    fi

    if [ "$virt" = "none" ]; then
        print_status INFO "Virtualization: not detected (likely bare metal)"
    else
        print_status INFO "Virtualization: $virt"
    fi

    if have xrandr && [ -n "${DISPLAY:-}" ]; then
        display_name="$(xrandr --current 2>/dev/null | awk '/ connected/{print $1; exit}')"
        resolution="$(xrandr --current 2>/dev/null | awk '/\*/{print $1; exit}')"
        if [ -n "$display_name" ]; then
            if [ -n "$resolution" ]; then
                print_status OK "Display: $display_name at $resolution"
            else
                print_status OK "Display: $display_name"
            fi
        else
            print_status WARN "xrandr did not report a connected display"
        fi
    else
        print_status WARN "Display information unavailable (xrandr/DISPLAY missing)"
    fi

    section "Desktop"
    check_command_process "BSPWM" "bspwm" "bspwm"
    check_command_process "sxhkd" "sxhkd" "sxhkd"
    check_command_process "Polybar" "polybar" "polybar"
    check_command_process "Picom" "picom" "picom"

    if have rofi; then
        print_status OK "Rofi is installed"
    else
        print_status FAIL "Rofi is not installed"
    fi

    if ! have flameshot; then
        print_status FAIL "Flameshot is not installed"
    elif process_running flameshot; then
        print_status OK "Flameshot is installed and available in the session"
    else
        print_status WARN "Flameshot is installed but its session process is not running"
    fi

    section "KaliPWM"
    check_helper "target" "$HOME/.config/polybar/obsidian/scripts/target.sh"
    check_helper "screenshot" "$HOME/.config/polybar/obsidian/scripts/screenshot.sh"
    check_helper "wallpaper" "$HOME/.config/bspwm/scripts/set-obsidian-wallpaper.sh"

    if [ -f "$HOME/.config/bspwm/bspwmrc" ]; then
        print_status OK "BSPWM configuration is present"
    else
        print_status FAIL "BSPWM configuration is missing"
    fi

    if [ -f "$HOME/.config/polybar/obsidian-v2/config.ini" ]; then
        print_status OK "Obsidian v2 Polybar configuration is present"
    else
        print_status FAIL "Obsidian v2 Polybar configuration is missing"
    fi

    if font_available 'Hack Nerd Font'; then
        print_status OK "Hack Nerd Font is available"
    else
        print_status FAIL "Hack Nerd Font is unavailable"
    fi

    if font_available 'JetBrainsMono Nerd Font'; then
        print_status OK "JetBrainsMono Nerd Font is available"
    else
        print_status FAIL "JetBrainsMono Nerd Font is unavailable"
    fi

    if [ -s "$target_file" ]; then
        print_status INFO "Target: $(/usr/bin/cat "$target_file")"
    else
        print_status INFO "Target: not set"
    fi

    if [ -s "$current_wallpaper_file" ]; then
        print_status INFO "Current wallpaper: $(/usr/bin/cat "$current_wallpaper_file")"
    elif [ -s "$choice_file" ]; then
        print_status INFO "Wallpaper choice: $(/usr/bin/cat "$choice_file")"
    else
        print_status INFO "Wallpaper choice: no persisted state found"
    fi

    section "Network"
    default_if="$(ip route show default 2>/dev/null | awk '/default/ {for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}')"
    if [ -n "$default_if" ]; then
        default_ip="$(ip -4 -o addr show dev "$default_if" scope global 2>/dev/null | awk '{print $4; exit}')"
        if [ -n "$default_ip" ]; then
            print_status OK "Default interface: $default_if ($default_ip)"
        else
            print_status OK "Default interface: $default_if"
        fi
    else
        print_status WARN "No default network interface detected"
    fi

    wifi_if="$(find_wifi_interface || true)"
    if [ -n "$wifi_if" ]; then
        print_status INFO "Wi-Fi interface: $wifi_if"
    else
        print_status INFO "Wi-Fi interface: not detected"
    fi

    vpn_if="$(find_vpn_interface)"
    if [ -n "$vpn_if" ]; then
        print_status INFO "VPN interface: $vpn_if"
    else
        print_status INFO "VPN: disconnected or no tunnel interface detected"
    fi

    section "Hardware"
    shopt -s nullglob
    batteries=(/sys/class/power_supply/BAT*)
    shopt -u nullglob
    if [ "${#batteries[@]}" -gt 0 ]; then
        print_status OK "Battery telemetry is available"
    else
        print_status INFO "Battery telemetry unavailable"
    fi

    gpu_name=""
    if have lspci; then
        gpu_name="$(lspci 2>/dev/null | grep -Ei 'VGA compatible controller|3D controller|Display controller' | head -n1 | sed -E 's/^[^:]+: //')"
    fi
    if [ -n "$gpu_name" ]; then
        print_status INFO "GPU controller: $gpu_name"
    else
        print_status INFO "GPU controller: unavailable"
    fi

    if have nvidia-smi && nvidia-smi -L >/dev/null 2>&1; then
        print_status OK "GPU telemetry is available through nvidia-smi"
    elif find /sys/class/drm -path '*/device/hwmon/hwmon*' -type d -print -quit 2>/dev/null | grep -q .; then
        print_status OK "GPU telemetry is available through sysfs"
    else
        print_status INFO "GPU telemetry unavailable"
    fi

    fan_file="$(find /sys/class/hwmon -type f -name 'fan*_input' -readable -print -quit 2>/dev/null)"
    if [ -n "$fan_file" ]; then
        print_status OK "Fan telemetry is available"
    else
        print_status INFO "Fan telemetry unavailable"
    fi

    section "Configuration"
    if [ -f "$bspwmrc" ]; then
        if grep -Eq 'xrandr[[:space:]].*--output[[:space:]]+Virtual1' "$bspwmrc"; then
            print_status WARN "Hard-coded display output detected: Virtual1"
        else
            print_status OK "No hard-coded Virtual1 display output detected"
        fi

        if grep -Eq '^[[:space:]]*vmware-user-suid-wrapper([[:space:]]|&|$)' "$bspwmrc"; then
            if [ "$virt" = "vmware" ]; then
                print_status INFO "VMware session helper is enabled on VMware"
            else
                print_status WARN "VMware session helper is enabled but VMware was not detected"
            fi
        else
            print_status INFO "VMware session helper is not enabled"
        fi
    else
        print_status FAIL "Cannot inspect BSPWM configuration"
    fi

    section "Summary"
    printf '%d OK | %d WARN | %d FAIL | %d INFO\n' \
        "$OK_COUNT" "$WARN_COUNT" "$FAIL_COUNT" "$INFO_COUNT"

    if [ "$FAIL_COUNT" -gt 0 ]; then
        return 1
    fi
    return 0
}

validate_update_repo() {
    local repo="$1"

    if [ ! -d "$repo/.git" ]; then
        printf 'KaliPWM update repository is not a Git checkout: %s\n' "$repo" >&2
        return 1
    fi

    for path in kalipwm.sh CONFIGS/config CONFIGS/zshrc CONFIGS/p10k.zsh CONFIGS/tmux.conf.local SCRIPTS/kalipwm SCRIPTS/screenshot.sh WALLPAPERS; do
        if [ ! -e "$repo/$path" ]; then
            printf 'KaliPWM update repository is missing: %s\n' "$repo/$path" >&2
            return 1
        fi
    done

    return 0
}

repo_is_clean() {
    local repo="$1"
    [ -z "$(git -C "$repo" status --porcelain --untracked-files=normal 2>/dev/null)" ]
}

apply_managed_update() {
    local repo="$1"

    validate_update_repo "$repo" || return 1

    printf 'Applying KaliPWM managed configuration from:\n  %s\n\n' "$repo"

    if ! have sudo; then
        printf 'sudo is required to refresh system-managed KaliPWM helpers.\n' >&2
        return 1
    fi

    sudo -v || return 1

    mkdir -p "$HOME/.config" "$HOME/.config/polybar/forest/scripts" "$HOME/screenshots" "$HOME/Wallpapers"

    cp -a "$repo/CONFIGS/config/." "$HOME/.config/" || return 1
    cp -f "$repo/CONFIGS/zshrc" "$HOME/.zshrc" || return 1
    cp -f "$repo/CONFIGS/p10k.zsh" "$HOME/.p10k.zsh" || return 1
    cp -f "$repo/CONFIGS/tmux.conf.local" "$HOME/.tmux.conf.local" || return 1
    cp -a "$repo/SCRIPTS/." "$HOME/.config/polybar/forest/scripts/" || return 1
    cp -f "$repo/SCRIPTS/screenshot.sh" "$HOME/.config/polybar/obsidian/scripts/screenshot.sh" || return 1
    cp -a "$repo/WALLPAPERS/." "$HOME/Wallpapers/" || return 1

    chmod +x "$HOME/.config/bspwm/bspwmrc" \
        "$HOME/.config/bspwm/scripts/bspwm_resize" \
        "$HOME/.config/bspwm/scripts/set-obsidian-wallpaper.sh" \
        "$HOME/.config/polybar/obsidian/launch.sh" \
        "$HOME/.config/polybar/obsidian-v2/launch.sh" || return 1
    chmod +x "$HOME/.config/polybar/obsidian/scripts/"*.sh || return 1
    chmod +x "$HOME/.config/polybar/obsidian-v2/scripts/"*.sh || return 1
    chmod +x "$HOME/.config/polybar/forest/scripts/target.sh" \
        "$HOME/.config/polybar/forest/scripts/screenshot.sh" || return 1

    sudo ln -sf "$HOME/.config/polybar/obsidian/scripts/target.sh" /usr/bin/target || return 1
    sudo ln -sf "$HOME/.config/polybar/obsidian/scripts/screenshot.sh" /usr/bin/screenshot || return 1
    sudo ln -sf "$HOME/.config/bspwm/scripts/set-obsidian-wallpaper.sh" /usr/bin/wallpaper || return 1
    sudo install -m 0755 "$repo/SCRIPTS/kalipwm" /usr/local/bin/kalipwm || return 1

    printf 'KaliPWM managed configuration updated successfully.\n'
    printf 'Toolchain packages and third-party source builds were not reinstalled.\n'
    printf 'Your Target and wallpaper choice state were preserved.\n'
    printf 'Run "kalipwm doctor" to verify the resulting state.\n'
}

run_update() {
    local repo="${KALIPWM_REPO:-$HOME/kalipwm}"
    local origin_url current_branch

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo)
                if [ "$#" -lt 2 ]; then
                    printf 'kalipwm update --repo requires a path.\n' >&2
                    return 2
                fi
                repo="$2"
                shift 2
                ;;
            -h|--help)
                /usr/bin/cat <<'HELP'
Usage:
  kalipwm update
  kalipwm update --repo PATH

Update the checked-out KaliPWM repository from origin/main, then refresh only
KaliPWM-managed configuration, wallpapers, helper symlinks and the management
command. The complete package/toolchain installer is not rerun.

Default repository: ~/kalipwm
Override with --repo PATH or KALIPWM_REPO.
HELP
                return 0
                ;;
            *)
                printf 'Unknown update option: %s\n' "$1" >&2
                return 2
                ;;
        esac
    done

    if ! have git; then
        printf 'git is required for kalipwm update.\n' >&2
        return 1
    fi

    repo="$(readlink -f "$repo" 2>/dev/null || printf '%s' "$repo")"
    validate_update_repo "$repo" || return 1

    if ! repo_is_clean "$repo"; then
        printf 'Refusing to update a dirty KaliPWM checkout: %s\n' "$repo" >&2
        printf 'Commit, stash or remove local changes first. Nothing was changed.\n' >&2
        git -C "$repo" status --short >&2
        return 1
    fi

    origin_url="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
    if [ -z "$origin_url" ]; then
        printf 'The KaliPWM checkout has no origin remote: %s\n' "$repo" >&2
        return 1
    fi

    printf 'KaliPWM update\n'
    printf 'Repository: %s\n' "$repo"
    printf 'Origin: %s\n\n' "$origin_url"

    printf '[1/3] Fetching origin/main...\n'
    git -C "$repo" fetch origin main || return 1

    current_branch="$(git -C "$repo" branch --show-current 2>/dev/null || true)"
    if [ "$current_branch" != "main" ]; then
        printf '[2/3] Switching from %s to main...\n' "${current_branch:-detached HEAD}"
        git -C "$repo" switch main || return 1
    else
        printf '[2/3] Already on main.\n'
    fi

    printf '[3/3] Fast-forwarding main from origin/main...\n'
    git -C "$repo" pull --ff-only origin main || return 1

    if ! repo_is_clean "$repo"; then
        printf 'Checkout became dirty after the Git update; refusing to deploy managed files.\n' >&2
        git -C "$repo" status --short >&2
        return 1
    fi

    printf '\nRepository update complete. Applying managed files with the updated command...\n\n'
    exec "$repo/SCRIPTS/kalipwm" __apply-update "$repo"
}

show_help() {
    /usr/bin/cat <<'HELP'
KaliPWM Obsidian management command

Usage:
  kalipwm doctor
  kalipwm update
  kalipwm help

Commands:
  doctor    Run a read-only diagnostic report for the KaliPWM desktop.
  update    Fast-forward the KaliPWM checkout and refresh managed configuration.
  help      Show this help.

Run "kalipwm update --help" for update-specific options.
The doctor command never uses sudo and never changes system configuration.
HELP
}

case "${1:-help}" in
    doctor)
        shift
        if [ "$#" -gt 0 ]; then
            printf 'Unknown doctor option: %s\n' "$1" >&2
            exit 2
        fi
        run_doctor
        ;;
    update)
        shift
        run_update "$@"
        ;;
    __apply-update)
        shift
        if [ "$#" -ne 1 ]; then
            printf 'Invalid internal update invocation.\n' >&2
            exit 2
        fi
        apply_managed_update "$1"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        printf 'Unknown command: %s\n\n' "$1" >&2
        show_help >&2
        exit 2
        ;;
esac
