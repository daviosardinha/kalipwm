#!/usr/bin/env bash
set -u

PROFILE="${XDG_CONFIG_HOME:-$HOME/.config}/kalipwm/profile.conf"
[[ -r "$PROFILE" ]] && source "$PROFILE"

wifi_interface="${wifi_interface:-}"
wired_interface="${wired_interface:-}"

is_up() {
  [[ -r "/sys/class/net/$1/operstate" ]] && [[ "$(cat "/sys/class/net/$1/operstate" 2>/dev/null)" == up ]]
}

ip_for() {
  ip -4 -o addr show dev "$1" scope global 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}'
}

route_iface="$(ip -4 route show default 2>/dev/null | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')"
iface=""

if [[ -n "$route_iface" && -e "/sys/class/net/$route_iface" ]]; then
  iface="$route_iface"
elif [[ -n "$wifi_interface" ]] && is_up "$wifi_interface"; then
  iface="$wifi_interface"
elif [[ -n "$wired_interface" ]] && is_up "$wired_interface"; then
  iface="$wired_interface"
fi

if [[ -z "$iface" ]]; then
  printf '%%{F#C95B6A}NET OFF%%{F-}\n'
  exit 0
fi

addr="$(ip_for "$iface")"
if [[ -z "$addr" ]]; then
  printf '%%{F#C95B6A}NET OFF%%{F-}\n'
  exit 0
fi

if [[ -d "/sys/class/net/$iface/wireless" ]]; then
  printf 'WLAN %s\n' "$addr"
else
  printf 'ETH %s\n' "$addr"
fi
