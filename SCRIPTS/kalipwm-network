#!/usr/bin/env bash
set -Eeuo pipefail

PROFILE="${KALIPWM_PROFILE_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/kalipwm/profile.conf}"
NET_ROOT="${KALIPWM_NET_ROOT:-/sys/class/net}"
[[ -r "$PROFILE" ]] && source "$PROFILE"

wifi_interface="${wifi_interface:-}"
wired_interface="${wired_interface:-}"

is_usable() {
  local iface="$1" state addr
  [[ -n "$iface" && -e "$NET_ROOT/$iface" ]] || return 1
  state="$(cat "$NET_ROOT/$iface/operstate" 2>/dev/null || true)"
  [[ "$state" == up || "$state" == unknown ]] || return 1
  addr="$(ip -4 -o addr show dev "$iface" scope global 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}')"
  [[ -n "$addr" ]]
}

ip_for() {
  ip -4 -o addr show dev "$1" scope global 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}'
}

kind_for() {
  local iface="$1"
  if [[ -d "$NET_ROOT/$iface/wireless" ]]; then
    printf 'WLAN\n'
  else
    printf 'ETH\n'
  fi
}

# Prefer the physical interface carrying the default route, but only when it
# matches the detected physical interfaces. A VPN default route must not make
# the network helper report the tunnel as Ethernet.
default_iface="$(ip -4 route show default 2>/dev/null | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')"
iface=""

if [[ -n "$default_iface" && ( "$default_iface" == "$wifi_interface" || "$default_iface" == "$wired_interface" ) ]] && is_usable "$default_iface"; then
  iface="$default_iface"
elif is_usable "$wifi_interface"; then
  iface="$wifi_interface"
elif is_usable "$wired_interface"; then
  iface="$wired_interface"
fi

if [[ -z "$iface" ]]; then
  printf 'NET OFF\n'
  exit 0
fi

printf '%s %s %s\n' "$(kind_for "$iface")" "$iface" "$(ip_for "$iface")"
