#!/usr/bin/env bash
set -u

for iface in /sys/class/net/tun* /sys/class/net/tap* /sys/class/net/wg*; do
  [[ -e "$iface" ]] || continue
  name="$(basename "$iface")"
  state="$(cat "$iface/operstate" 2>/dev/null || true)"
  [[ "$state" == up || "$state" == unknown ]] || continue
  addr="$(ip -4 -o addr show dev "$name" scope global 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}')"
  [[ -n "$addr" ]] || continue
  printf 'VPN %s %s\n' "$name" "$addr"
  exit 0
done

exit 0
