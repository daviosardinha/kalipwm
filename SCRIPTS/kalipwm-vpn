#!/usr/bin/env bash
set -Eeuo pipefail

candidate_interfaces() {
  local name iface
  declare -A seen=()

  # WireGuard interfaces may have arbitrary names (for example ronin66), so
  # discover them from wg instead of assuming the interface starts with wg.
  if command -v wg >/dev/null 2>&1; then
    while read -r name; do
      [[ -n "$name" && -z ${seen[$name]:-} ]] || continue
      seen[$name]=1
      printf '%s\n' "$name"
    done < <(wg show interfaces 2>/dev/null | tr ' ' '\n')
  fi

  # Preserve conventional TUN/TAP/WireGuard discovery for OpenVPN and similar.
  for iface in /sys/class/net/tun* /sys/class/net/tap* /sys/class/net/wg*; do
    [[ -e "$iface" ]] || continue
    name="$(basename "$iface")"
    [[ -z ${seen[$name]:-} ]] || continue
    seen[$name]=1
    printf '%s\n' "$name"
  done
}

while read -r name; do
  [[ -n "$name" ]] || continue

  state="$(cat "/sys/class/net/$name/operstate" 2>/dev/null || true)"
  if [[ -n "$state" ]]; then
    [[ "$state" == up || "$state" == unknown ]] || continue
  else
    ip link show dev "$name" >/dev/null 2>&1 || continue
  fi

  addr="$(ip -4 -o addr show dev "$name" scope global 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}')"
  [[ -n "$addr" ]] || continue

  printf 'VPN ON %s %s\n' "$name" "$addr"
  exit 0
done < <(candidate_interfaces)

printf 'VPN OFF\n'
