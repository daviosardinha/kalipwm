#!/usr/bin/env bash
set -u

parts=()

# CPU/package temperature: prefer common package/core thermal zones, otherwise
# use the first plausible thermal zone. Values are reported in millidegrees C.
cpu_temp=""
for zone in /sys/class/thermal/thermal_zone*; do
  [[ -r "$zone/temp" ]] || continue
  type="$(cat "$zone/type" 2>/dev/null || true)"
  case "$type" in
    x86_pkg_temp|cpu-thermal|cpu_thermal|TCPU|Package*)
      raw="$(cat "$zone/temp" 2>/dev/null || true)"
      [[ "$raw" =~ ^[0-9]+$ ]] && { cpu_temp=$((raw / 1000)); break; }
      ;;
  esac
done

if [[ -z "$cpu_temp" ]]; then
  for zone in /sys/class/thermal/thermal_zone*; do
    [[ -r "$zone/temp" ]] || continue
    raw="$(cat "$zone/temp" 2>/dev/null || true)"
    if [[ "$raw" =~ ^[0-9]+$ ]] && (( raw >= 15000 && raw <= 120000 )); then
      cpu_temp=$((raw / 1000)); break
    fi
  done
fi
[[ -n "$cpu_temp" ]] && parts+=("CPU ${cpu_temp}°")

# Never call nvidia-smi just to discover whether a hybrid-laptop dGPU is asleep:
# doing so can wake the device and cost battery. Read PCI runtime PM state first
# and query NVIDIA temperature only when at least one NVIDIA device is already
# active. KALIPWM_FORCE_GPU_TELEMETRY=1 is available for systems without usable
# runtime PM reporting where the user explicitly wants GPU telemetry.
nvidia_runtime_active() {
  local dev vendor runtime
  for dev in /sys/bus/pci/devices/*; do
    [[ -r "$dev/vendor" ]] || continue
    vendor="$(cat "$dev/vendor" 2>/dev/null || true)"
    [[ "$vendor" == 0x10de ]] || continue

    runtime="$(cat "$dev/power/runtime_status" 2>/dev/null || true)"
    [[ "$runtime" == active ]] && return 0
  done
  return 1
}

if command -v nvidia-smi >/dev/null 2>&1 && \
   { [[ ${KALIPWM_FORCE_GPU_TELEMETRY:-0} == 1 ]] || nvidia_runtime_active; }; then
  gpu_temp="$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]')"
  [[ "$gpu_temp" =~ ^[0-9]+$ ]] && parts+=("GPU ${gpu_temp}°")
fi

# Use the first available fan RPM sensor. Zero is valid on laptops with fan-stop.
fan=""
for input in /sys/class/hwmon/hwmon*/fan*_input; do
  [[ -r "$input" ]] || continue
  value="$(cat "$input" 2>/dev/null || true)"
  [[ "$value" =~ ^[0-9]+$ ]] || continue
  fan="$value"
  break
done
[[ -n "$fan" ]] && parts+=("FAN $fan")

((${#parts[@]})) || exit 0
printf '%s\n' "$(IFS=' '; echo "${parts[*]}")"
