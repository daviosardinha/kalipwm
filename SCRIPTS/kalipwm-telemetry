#!/usr/bin/env bash
set -Eeuo pipefail

THERMAL_ROOT="${KALIPWM_THERMAL_ROOT:-/sys/class/thermal}"
HWMON_ROOT="${KALIPWM_HWMON_ROOT:-/sys/class/hwmon}"
PCI_ROOT="${KALIPWM_PCI_ROOT:-/sys/bus/pci/devices}"
MODE="${1:-status}"

valid_millidegree() {
  [[ ${1:-} =~ ^[0-9]+$ ]] && (( $1 >= 15000 && $1 <= 120000 ))
}

cpu_temp_from_hwmon() {
  local hw name input label raw

  # Prefer the CPU package sensor exported by coretemp/k10temp. This is more
  # representative and stable than picking an arbitrary ACPI thermal zone.
  for hw in "$HWMON_ROOT"/hwmon*; do
    [[ -r "$hw/name" ]] || continue
    name="$(cat "$hw/name" 2>/dev/null || true)"
    case "$name" in coretemp|k10temp|zenpower|cpu_thermal) ;; *) continue ;; esac

    for input in "$hw"/temp*_input; do
      [[ -r "$input" ]] || continue
      label="$(cat "${input%_input}_label" 2>/dev/null || true)"
      case "$label" in
        'Package id '*|Package*|Tctl|Tdie|CPU|CPU*) ;;
        '') [[ "$name" == k10temp || "$name" == zenpower || "$name" == cpu_thermal ]] || continue ;;
        *) continue ;;
      esac

      raw="$(cat "$input" 2>/dev/null || true)"
      valid_millidegree "$raw" && { printf '%s\n' "$((raw / 1000))"; return 0; }
    done
  done
  return 1
}

cpu_temp_from_thermal() {
  local wanted zone type raw

  # Deterministic priority rather than relying on thermal_zone glob order.
  for wanted in x86_pkg_temp TCPU TCPU_PCI cpu-thermal cpu_thermal; do
    for zone in "$THERMAL_ROOT"/thermal_zone*; do
      [[ -r "$zone/temp" && -r "$zone/type" ]] || continue
      type="$(cat "$zone/type" 2>/dev/null || true)"
      [[ "$type" == "$wanted" ]] || continue
      raw="$(cat "$zone/temp" 2>/dev/null || true)"
      valid_millidegree "$raw" && { printf '%s\n' "$((raw / 1000))"; return 0; }
    done
  done
  return 1
}

cpu_temp_fallback() {
  local zone raw
  for zone in "$THERMAL_ROOT"/thermal_zone*; do
    [[ -r "$zone/temp" ]] || continue
    raw="$(cat "$zone/temp" 2>/dev/null || true)"
    valid_millidegree "$raw" && { printf '%s\n' "$((raw / 1000))"; return 0; }
  done
  return 1
}

nvidia_runtime_active() {
  local dev vendor runtime
  for dev in "$PCI_ROOT"/*; do
    [[ -r "$dev/vendor" ]] || continue
    vendor="$(cat "$dev/vendor" 2>/dev/null || true)"
    [[ "$vendor" == 0x10de ]] || continue
    runtime="$(cat "$dev/power/runtime_status" 2>/dev/null || true)"
    [[ "$runtime" == active ]] && return 0
  done
  return 1
}

collect_fans() {
  local hw name input value index found=0

  # Lenovo's WMI hwmon driver exposes the Legion fan tachometers. Keep every
  # available fan because their exact physical mapping is firmware-specific.
  for hw in "$HWMON_ROOT"/hwmon*; do
    [[ -r "$hw/name" ]] || continue
    name="$(cat "$hw/name" 2>/dev/null || true)"
    [[ "$name" == lenovo_wmi_other ]] || continue

    for input in "$hw"/fan*_input; do
      [[ -r "$input" ]] || continue
      value="$(cat "$input" 2>/dev/null || true)"
      [[ "$value" =~ ^[0-9]+$ ]] || continue
      index="$(basename "$input")"
      index="${index#fan}"
      index="${index%_input}"
      printf '%s:%s\n' "$index" "$value"
      found=1
    done
  done

  (( found )) && return 0

  # Generic fallback for non-Lenovo systems: preserve the first readable fan.
  for input in "$HWMON_ROOT"/hwmon*/fan*_input; do
    [[ -r "$input" ]] || continue
    value="$(cat "$input" 2>/dev/null || true)"
    [[ "$value" =~ ^[0-9]+$ ]] || continue
    index="$(basename "$input")"
    index="${index#fan}"
    index="${index%_input}"
    printf '%s:%s\n' "$index" "$value"
    return 0
  done

  return 1
}

render_fans_compact() {
  local entry value values=()
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    value="${entry#*:}"
    values+=("$value")
  done < <(collect_fans || true)

  ((${#values[@]})) || return 1
  printf 'FAN %sRPM\n' "$(IFS=/; echo "${values[*]}")"
}

render_fans_detail() {
  local entry index value parts=()
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    index="${entry%%:*}"
    value="${entry#*:}"
    parts+=("FAN${index} ${value}RPM")
  done < <(collect_fans || true)

  ((${#parts[@]})) || return 1
  printf '%s\n' "$(IFS=' '; echo "${parts[*]}")"
}

main() {
  local cpu_temp gpu_temp fans
  local parts=()

  cpu_temp="$(cpu_temp_from_hwmon || cpu_temp_from_thermal || cpu_temp_fallback || true)"
  [[ -n "$cpu_temp" ]] && parts+=("CPU ${cpu_temp}C")

  # Never wake an idle NVIDIA dGPU just to draw telemetry. Query nvidia-smi only
  # when runtime PM already reports the device active, unless explicitly forced.
  if command -v nvidia-smi >/dev/null 2>&1 && \
     { [[ ${KALIPWM_FORCE_GPU_TELEMETRY:-0} == 1 ]] || nvidia_runtime_active; }; then
    gpu_temp="$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]')"
    [[ "$gpu_temp" =~ ^[0-9]+$ ]] && parts+=("GPU ${gpu_temp}C")
  fi

  case "$MODE" in
    status|compact)
      fans="$(render_fans_compact || true)"
      ;;
    detail|details)
      fans="$(render_fans_detail || true)"
      ;;
    *)
      printf 'Usage: kalipwm-telemetry [status|compact|detail]\n' >&2
      exit 2
      ;;
  esac
  [[ -n "$fans" ]] && parts+=("$fans")

  if ((${#parts[@]})); then
    printf 'TEMP %s\n' "$(IFS=' '; echo "${parts[*]}")"
  else
    printf 'TEMP N/A\n'
  fi
}

main
