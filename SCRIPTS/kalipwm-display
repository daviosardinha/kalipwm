#!/usr/bin/env bash
set -u

PROFILE="${XDG_CONFIG_HOME:-$HOME/.config}/kalipwm/profile.conf"
[[ -r "$PROFILE" ]] && source "$PROFILE"

environment="${environment:-baremetal}"
external_position="${external_position:-right}"
internal_display="${internal_display:-}"

connected_outputs() {
  xrandr --query 2>/dev/null | awk '$2=="connected" {print $1}'
}

array_contains() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

output_geometry() {
  local output="$1"
  xrandr --query 2>/dev/null | awk -v output="$output" '
    $1 == output && $2 == "connected" {
      for (i = 3; i <= NF; i++) {
        if ($i ~ /^[0-9]+x[0-9]+\+[0-9-]+\+[0-9-]+$/) {
          print $i
          exit
        }
      }
    }
  '
}

find_internal() {
  local out
  if [[ -n "$internal_display" ]] && xrandr --query 2>/dev/null | grep -q "^${internal_display} connected"; then
    printf '%s\n' "$internal_display"
    return
  fi
  while read -r out; do
    [[ "$out" =~ ^(eDP|LVDS) ]] && { printf '%s\n' "$out"; return; }
  done < <(connected_outputs)
}

apply_layout() {
  command -v xrandr >/dev/null 2>&1 || return 0
  [[ -n "${DISPLAY:-}" ]] || return 0

  mapfile -t outputs < <(connected_outputs)
  ((${#outputs[@]})) || return 0

  # Virtual displays resize themselves through guest integrations. Never force
  # a physical laptop topology inside VMware/VirtualBox/KVM.
  if [[ "$environment" != baremetal ]]; then
    local out
    for out in "${outputs[@]}"; do
      xrandr --output "$out" --auto 2>/dev/null || true
    done
    return 0
  fi

  local internal external previous out
  internal="$(find_internal)"

  if [[ -z "$internal" ]]; then
    internal="${outputs[0]}"
  fi

  xrandr --output "$internal" --auto --primary 2>/dev/null || true

  external=""
  for out in "${outputs[@]}"; do
    [[ "$out" == "$internal" ]] && continue
    if [[ -z "$external" ]]; then
      external="$out"
      case "$external_position" in
        left)   xrandr --output "$external" --auto --left-of "$internal" 2>/dev/null || true ;;
        above)  xrandr --output "$external" --auto --above "$internal" 2>/dev/null || true ;;
        below)  xrandr --output "$external" --auto --below "$internal" 2>/dev/null || true ;;
        mirror) xrandr --output "$external" --auto --same-as "$internal" 2>/dev/null || true ;;
        *)      xrandr --output "$external" --auto --right-of "$internal" 2>/dev/null || true ;;
      esac
      previous="$external"
    else
      # Additional monitors are chained to the right to avoid overlap.
      xrandr --output "$out" --auto --right-of "$previous" 2>/dev/null || true
      previous="$out"
    fi
  done
}

reconcile_bspwm() {
  command -v bspc >/dev/null 2>&1 || return 0
  bspc query -M --names >/dev/null 2>&1 || return 0

  local out monitor geometry primary desktop
  local -a outputs bspwm_monitors desktops
  mapfile -t outputs < <(connected_outputs)
  ((${#outputs[@]})) || return 0

  primary="$(find_internal)"
  [[ -n "$primary" ]] || primary="${outputs[0]}"

  # RandR may expose a reconnected USB-C display under a different provider
  # output name (for example DP-1 -> DP-1-1). Add every currently connected
  # output that BSPWM has not learned about yet. This does not alter provider
  # routing; it only mirrors the topology already reported by XRandR.
  mapfile -t bspwm_monitors < <(bspc query -M --names 2>/dev/null)
  for out in "${outputs[@]}"; do
    if ! array_contains "$out" "${bspwm_monitors[@]}"; then
      geometry="$(output_geometry "$out")"
      [[ -n "$geometry" ]] && bspc wm -a "$out" "$geometry" >/dev/null 2>&1 || true
    fi
  done

  # Move desktops away from stale monitor objects before removing them. BSPWM
  # otherwise keeps disconnected RandR names around and can strand workspaces.
  mapfile -t bspwm_monitors < <(bspc query -M --names 2>/dev/null)
  for monitor in "${bspwm_monitors[@]}"; do
    array_contains "$monitor" "${outputs[@]}" && continue
    mapfile -t desktops < <(bspc query -D -m "$monitor" --names 2>/dev/null)
    for desktop in "${desktops[@]}"; do
      bspc desktop "$desktop" -m "$primary" >/dev/null 2>&1 || true
    done
    bspc monitor "$monitor" -r >/dev/null 2>&1 || true
  done

  # Keep the V1 workspace model stable while monitors come and go. Existing
  # desktops (and their windows) are moved; they are not destroyed/recreated.
  mapfile -t desktops < <(bspc query -D --names 2>/dev/null)
  for desktop in I II III IV V; do
    if ! array_contains "$desktop" "${desktops[@]}"; then
      bspc monitor "$primary" -a "$desktop" >/dev/null 2>&1 || true
      desktops+=("$desktop")
    fi
  done

  case "${#outputs[@]}" in
    1)
      for desktop in I II III IV V; do
        bspc desktop "$desktop" -m "${outputs[0]}" >/dev/null 2>&1 || true
      done
      ;;
    2)
      for desktop in I II III; do
        bspc desktop "$desktop" -m "${outputs[0]}" >/dev/null 2>&1 || true
      done
      for desktop in IV V; do
        bspc desktop "$desktop" -m "${outputs[1]}" >/dev/null 2>&1 || true
      done
      ;;
    *)
      for desktop in I II; do
        bspc desktop "$desktop" -m "${outputs[0]}" >/dev/null 2>&1 || true
      done
      for desktop in III IV; do
        bspc desktop "$desktop" -m "${outputs[1]}" >/dev/null 2>&1 || true
      done
      bspc desktop V -m "${outputs[2]}" >/dev/null 2>&1 || true
      ;;
  esac

  # `bspc wm -a` creates a placeholder desktop named "Desktop" on a newly
  # learned monitor. Once the canonical I-V workspaces have been distributed,
  # remove that placeholder only when it is empty.
  if bspc query -D --names 2>/dev/null | grep -qx 'Desktop'; then
    if ! bspc query -N -d Desktop 2>/dev/null | grep -q .; then
      bspc desktop Desktop -r >/dev/null 2>&1 || true
    fi
  fi

  # Match BSPWM monitor ordering to the already-active XRandR topology.
  bspc wm -O "${outputs[@]}" >/dev/null 2>&1 || true
}

restart_polybar() {
  local launcher="$HOME/.config/polybar/forest/launch.sh"
  [[ -x "$launcher" ]] || return 0
  "$launcher" >/dev/null 2>&1 || true
}

apply_all() {
  local restart_bar="${1:-false}"
  apply_layout
  sleep 0.2
  reconcile_bspwm
  if [[ "$restart_bar" == true ]]; then
    restart_polybar
  fi
  return 0
}

topology_signature() {
  connected_outputs | paste -sd, -
}

watch_layout() {
  local previous current

  # Establish a clean baseline without restarting Polybar. BSPWM startup owns
  # the initial bar launch, avoiding a race between the first bar and watcher.
  apply_all false
  previous="$(topology_signature)"

  while sleep 3; do
    current="$(topology_signature)"
    if [[ "$current" != "$previous" ]]; then
      # Give RandR a short debounce window so provider-backed USB-C outputs can
      # settle before BSPWM and Polybar are reconciled.
      sleep 1
      apply_all true
      previous="$(topology_signature)"
    fi
  done
}

case "${1:-apply}" in
  apply) apply_all false ;;
  --watch|watch) watch_layout ;;
  *) echo "Usage: kalipwm-display [apply|--watch]" >&2; exit 2 ;;
esac
