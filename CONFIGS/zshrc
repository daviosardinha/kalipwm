# KaliPWM V1 — Obsidian Tactical ZSH configuration

# Powerlevel10k instant prompt. Keep this near the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export PATH="$HOME/.local/bin:$PATH"
export ZSH="$HOME/.oh-my-zsh"
export EDITOR=vim
export VISUAL=vim

ZSH_THEME="powerlevel10k/powerlevel10k"

# Keep shell startup useful without redefining standard Unix commands.
# In particular:
#   cat  -> /usr/bin/cat
#   vim  -> Vim
# batcat/lsd remain available explicitly when installed.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting sudo encode64)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# Convenience aliases that do not shadow core commands.
command -v lsd >/dev/null 2>&1 && alias ll='lsd -lah'
alias grep='grep --color=auto'

# Debian/Kali fzf package integration when present.
[[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -r /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh

# Powerlevel10k user configuration.
[[ -r ~/.p10k.zsh ]] && source ~/.p10k.zsh
