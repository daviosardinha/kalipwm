# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git zsh-autosuggestions zsh-syntax-highlighting sudo encode64)
source $ZSH/oh-my-zsh.sh

# Native command policy: keep core Unix tools predictable.
# Do not transparently replace cat/vim with batcat/neovim.
export EDITOR='/usr/bin/vim'
export VISUAL='/usr/bin/vim'

unalias cat 2>/dev/null
unalias vi 2>/dev/null
unalias vim 2>/dev/null
alias cat='/usr/bin/cat'
alias vi='/usr/bin/vim'
alias vim='/usr/bin/vim'

# Keep the enhanced ls presentation only; it does not change file contents or editor behavior.
alias ls='lsd'

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
