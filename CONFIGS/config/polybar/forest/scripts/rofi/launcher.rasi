/* KaliPWM V1 — Obsidian Tactical Rofi launcher */

* {
    background:       #0F1117F2;
    background-alt:   #171A22F2;
    selected:         #2B2638F2;
    foreground:       #D7D9E0FF;
    muted:            #9298A6FF;
    accent:           #9B7EDEFF;
    border:           #303541FF;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 560px;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    background-color: @background;
}

mainbox {
    spacing: 12px;
    padding: 18px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 10px;
    padding: 12px 14px;
    border: 1px;
    border-color: @border;
    border-radius: 9px;
    background-color: @background-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    background-color: transparent;
    str: "";
}

entry {
    placeholder: "Search applications…";
    placeholder-color: @muted;
    text-color: @foreground;
    background-color: transparent;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    cycle: true;
    scrollbar: false;
    spacing: 4px;
    background-color: transparent;
}

element {
    padding: 10px 12px;
    spacing: 10px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @foreground;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @foreground;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
