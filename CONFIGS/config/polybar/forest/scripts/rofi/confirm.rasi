/* KaliPWM V1 — Obsidian Tactical confirmation dialog */

* {
    background:          #0F1117F2;
    background-alt:      #171A22F2;
    selected:            #342B46F2;
    selected-foreground: #F4F1FFFF;
    foreground:          #D7D9E0FF;
    muted:               #9298A6FF;
    accent:              #9B7EDEFF;
    border:              #303541FF;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 320px;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    background-color: @background;
}

mainbox {
    spacing: 10px;
    padding: 16px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 10px 12px;
    border-radius: 8px;
    background-color: @background-alt;
    children: [ prompt ];
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

listview {
    lines: 2;
    columns: 1;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
    spacing: 5px;
    background-color: transparent;
}

element {
    padding: 10px 12px;
    border: 1px;
    border-color: transparent;
    border-radius: 8px;
    background-color: transparent;
    text-color: @foreground;
}

/* Confirmation choices use the same explicit keyboard-focus treatment as the
 * parent power menu so Yes/No can never be selected blindly. */
element selected.normal {
    background-color: @selected;
    border-color: @accent;
    text-color: @selected-foreground;
}

element selected.active {
    background-color: @selected;
    border-color: @accent;
    text-color: @selected-foreground;
}

element selected.urgent {
    background-color: @selected;
    border-color: @accent;
    text-color: @selected-foreground;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
