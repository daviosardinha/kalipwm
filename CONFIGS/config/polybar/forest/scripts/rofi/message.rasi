/* KaliPWM V1 — Obsidian Tactical message dialog */

* {
    background:       #0F1117F2;
    foreground:       #D7D9E0FF;
    accent:           #9B7EDEFF;
    border:           #303541FF;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 420px;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    padding: 18px;
    background-color: @background;
}

mainbox {
    background-color: transparent;
}

textbox {
    text-color: @foreground;
    background-color: transparent;
    vertical-align: 0.5;
}
