/* KaliPWM V1 — Obsidian Tactical power menu */

* {
    background:       #0F1117F2;
    background-alt:   #171A22F2;
    selected:         #2B2638F2;
    foreground:       #D7D9E0FF;
    muted:            #9298A6FF;
    accent:           #9B7EDEFF;
    border:           #303541FF;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 430px;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    background-color: @background;
}

mainbox {
    spacing: 10px;
    padding: 16px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 10px;
    padding: 11px 13px;
    border: 1px;
    border-color: @border;
    border-radius: 9px;
    background-color: @background-alt;
    children: [ textbox-prompt-colon, prompt ];
}

textbox-prompt-colon {
    expand: false;
    str: "󰐥";
    text-color: @accent;
    background-color: transparent;
}

prompt {
    text-color: @muted;
    background-color: transparent;
}

listview {
    lines: 5;
    columns: 1;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
    spacing: 5px;
    background-color: transparent;
}

element {
    padding: 11px 13px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @foreground;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @foreground;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
