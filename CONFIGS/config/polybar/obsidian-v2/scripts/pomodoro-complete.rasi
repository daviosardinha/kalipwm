* {
    background:     #0B0D12;
    background-alt: #181B24;
    foreground:     #E7EAF0;
    muted:          #9AA1B2;
    violet:         #9B7EDE;
    violet-bright:  #B9A3F4;

    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 460px;
    location: center;
    anchor: center;
    background-color: @background;
    border: 2px;
    border-color: @violet;
    border-radius: 14px;
    padding: 22px;
}

mainbox {
    background-color: transparent;
    spacing: 16px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: transparent;
    children: [ prompt ];
}

prompt {
    background-color: transparent;
    text-color: @violet-bright;
    font: "JetBrainsMono Nerd Font Bold 15";
    horizontal-align: 0.5;
    padding: 4px 0 2px 0;
}

message {
    background-color: @background-alt;
    border: 1px;
    border-color: #2A2E3A;
    border-radius: 8px;
    padding: 12px;
}

textbox {
    background-color: transparent;
    text-color: @foreground;
    horizontal-align: 0.5;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 3;
    spacing: 8px;
    scrollbar: false;
    fixed-height: true;
}

element {
    background-color: @background-alt;
    text-color: @foreground;
    border: 1px;
    border-color: #2A2E3A;
    border-radius: 8px;
    padding: 10px 14px;
}

element selected {
    background-color: @violet-bright;
    text-color: #0B0D12;
    border-color: @violet-bright;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
}

entry {
    enabled: false;
}
