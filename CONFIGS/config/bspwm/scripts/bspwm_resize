#!/usr/bin/env bash
set -u

# KaliPWM V1 — directional BSPWM resize helper.
# Tiled windows resize their nearest split boundary; floating windows resize
# their own edge. A single tiled window has no split boundary to resize.

if bspc query -N -n focused.floating >/dev/null 2>&1; then
    step=20
else
    step=100
fi

case "${1:-}" in
    west)
        primary=left
        fallback=right
        x="-$step"
        y=0
        ;;
    east)
        primary=right
        fallback=left
        x="$step"
        y=0
        ;;
    north)
        primary=top
        fallback=bottom
        x=0
        y="-$step"
        ;;
    south)
        primary=bottom
        fallback=top
        x=0
        y="$step"
        ;;
    *)
        printf 'Usage: bspwm_resize {west|east|north|south}\n' >&2
        exit 2
        ;;
esac

bspc node -z "$primary" "$x" "$y" 2>/dev/null || \
    bspc node -z "$fallback" "$x" "$y" 2>/dev/null
