#!/usr/bin/env bash
set -u

# KaliPWM V1 — BSPWM resize helper.
# Keep the upstream split-boundary algorithm: it first moves the historically
# expected edge and falls back to the opposite edge when that boundary is not
# available. This behavior is important for tiled trees where the focused node
# can sit on either side of its parent split.

if bspc query -N -n focused.floating >/dev/null 2>&1; then
    step=20
else
    step=100
fi

case "${1:-}" in
    west)
        dir=right
        falldir=left
        x="-$step"
        y=0
        ;;
    east)
        dir=right
        falldir=left
        x="$step"
        y=0
        ;;
    north)
        dir=top
        falldir=bottom
        x=0
        y="-$step"
        ;;
    south)
        dir=top
        falldir=bottom
        x=0
        y="$step"
        ;;
    *)
        printf 'Usage: bspwm_resize {west|east|north|south}\n' >&2
        exit 2
        ;;
esac

bspc node -z "$dir" "$x" "$y" 2>/dev/null || \
    bspc node -z "$falldir" "$x" "$y" 2>/dev/null
