#! /bin/sh

wmname LG3D &

# Start VMware desktop integration only inside an actual VMware guest.
if command -v systemd-detect-virt >/dev/null 2>&1 \
    && [ "$(systemd-detect-virt 2>/dev/null || true)" = "vmware" ] \
    && command -v vmware-user-suid-wrapper >/dev/null 2>&1; then
    vmware-user-suid-wrapper &
fi

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width         2
bspc config window_gap          6

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
# Flameshot 14 creates top-level monitor/editor windows on multi-monitor X11.
# Keep those windows out of BSPWM tiling while preserving keyboard focus.
bspc rule -a flameshot state=floating layer=above border=off focus=on

# DISPLAY
# Preserve active modes and watch for live output connect/disconnect events.
# The watcher only auto-enables newly connected inactive outputs; existing
# active layouts and refresh rates are left untouched.
if [ -x "$HOME/.config/bspwm/scripts/display-hotplug.sh" ]; then
    "$HOME/.config/bspwm/scripts/display-hotplug.sh" >/dev/null 2>&1 &
fi

# WALLPAPER - Obsidian v2
# No argument means: restore the wallpaper choice saved by the installer/user.
~/.config/bspwm/scripts/set-obsidian-wallpaper.sh

# POLYBAR - Obsidian v2
~/.config/polybar/obsidian-v2/launch.sh

# CUSTOM
bspc config focus_follows_pointer true

# PICOM
picom &
bspc config border_width 0

xsetroot -cursor_name left_ptr &
