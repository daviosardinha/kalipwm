#! /bin/sh

wmname LG3D &

# Start VMware desktop integration only inside an actual VMware guest.
if command -v systemd-detect-virt >/dev/null 2>&1 \
    && [ "$(systemd-detect-virt 2>/dev/null || true)" = "vmware" ] \
    && command -v vmware-user-suid-wrapper >/dev/null 2>&1; then
    vmware-user-suid-wrapper &
fi

pgrep -x sxhkd > /dev/null || sxhkd &

# DISPLAY
# BSPWM does not have the XFCE display daemon behind it. Make newly connected
# external outputs usable before assigning desktops, while preserving layouts
# that X already activated (including deliberate external-only setups).
DISPLAY_HELPER="$HOME/.config/bspwm/scripts/kalipwm-display.sh"
if [ -x "$DISPLAY_HELPER" ]; then
    "$DISPLAY_HELPER" auto >/tmp/kalipwm-display.log 2>&1 || true
    # Give BSPWM a moment to consume the RandR topology change.
    sleep 0.4
    if ! "$DISPLAY_HELPER" workspaces >>/tmp/kalipwm-display.log 2>&1; then
        bspc monitor -d I II III IV V VI VII VIII IX X
    fi
else
    bspc monitor -d I II III IV V VI VII VIII IX X
fi

# Keep the same display policy alive after login so connecting or disconnecting
# an external monitor does not depend on a full BSPWM restart. The helper uses
# a per-user flock, so bspwmrc reloads cannot create duplicate watchers.
if [ -x "$DISPLAY_HELPER" ]; then
    "$DISPLAY_HELPER" watch >>/tmp/kalipwm-display-watch.log 2>&1 &
fi

bspc config border_width         2
bspc config window_gap          6

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Obsidian window chrome. Keep inactive borders subdued and use the same
# violet family as the Control Center for the focused window.
bspc config normal_border_color   "#2A2633"
bspc config active_border_color   "#66548F"
bspc config focused_border_color  "#9B7EDE"
bspc config presel_feedback_color "#B8A2F2"

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# WALLPAPER - Obsidian v2
# No argument means: restore the wallpaper choice saved by the installer/user.
~/.config/bspwm/scripts/set-obsidian-wallpaper.sh

# POLYBAR - Obsidian v2
~/.config/polybar/obsidian-v2/launch.sh

# CUSTOM
bspc config focus_follows_pointer true

# PICOM
pgrep -x picom > /dev/null || picom &

xsetroot -cursor_name left_ptr &