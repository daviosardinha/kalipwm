##########################
# KaliPWM V1 — sxhkd     #
##########################

# Terminal
super + Return
    kitty

# Rofi / application launcher
super + d
    ~/.config/polybar/forest/scripts/launcher.sh

# Reload sxhkd configuration
super + Escape
    pkill -USR1 -x sxhkd

#################
# BSPWM controls #
#################

# Quit / restart BSPWM
super + alt + {q,r}
    bspc {quit,wm -r}

# Close / kill window
super + {_,shift + }w
    bspc node -{c,k}

# Tiled / monocle
super + m
    bspc desktop -l next

# Window state
super + {t,shift + t,s,f}
    bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Node flags
super + ctrl + {m,x,y,z}
    bspc node -g {marked,locked,sticky,private}

# Focus / swap directional windows
super + {_,shift + }{Left,Down,Up,Right}
    bspc node -{f,s} {west,south,north,east}

# Previous / next desktop
super + bracket{left,right}
    bspc desktop -f {prev,next}.local

# Last window / desktop
super + {grave,Tab}
    bspc {node,desktop} -f last

# Focus or send to workspaces I–V
super + {_,shift + }{1-5}
    bspc {desktop -f,node -d} '^{1-5}'

# Preselect direction
super + ctrl + alt + {Left,Down,Up,Right}
    bspc node -p {west,south,north,east}

# Preselect ratio
super + ctrl + {1-9}
    bspc node -o 0.{1-9}

# Cancel preselection
super + ctrl + space
    bspc node -p cancel

super + ctrl + alt + space
    bspc query -N -d | xargs -r -I id -n 1 bspc node id -p cancel

# Move a floating window
super + ctrl + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# Resize current window
super + alt + {Left,Down,Up,Right}
    ~/.config/bspwm/scripts/bspwm_resize {west,south,north,east}

#####################
# Operator launchers #
#####################

super + shift + f
    firefox

super + shift + b
    burpsuite

super + shift + a
    thunar

################
# Screenshots  #
################

# Interactive region + annotation. Ctrl+C inside Flameshot copies the
# selected image to the clipboard without saving it automatically.
Print
    ~/.local/bin/screenshot.sh gui

# Keep Ctrl+Print consistent with the screenshot workflow: open Flameshot
# directly in capture mode rather than the separate launcher/menu.
ctrl + Print
    ~/.local/bin/screenshot.sh gui

# Full desktop directly to the screenshots folder.
shift + Print
    ~/.local/bin/screenshot.sh full

################
# Audio        #
################

# Use the command form validated on bare metal, then display the current
# level through the session notification daemon.
XF86AudioRaiseVolume
    sh -c '/usr/bin/wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ && "$HOME/.local/bin/kalipwm-osd" volume'

XF86AudioLowerVolume
    sh -c '/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && "$HOME/.local/bin/kalipwm-osd" volume'

XF86AudioMute
    sh -c '/usr/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && "$HOME/.local/bin/kalipwm-osd" volume'

################
# Brightness   #
################

XF86MonBrightnessDown
    sh -c '/usr/bin/brightnessctl set 10%- >/dev/null && "$HOME/.local/bin/kalipwm-osd" brightness'

XF86MonBrightnessUp
    sh -c '/usr/bin/brightnessctl set +10% >/dev/null && "$HOME/.local/bin/kalipwm-osd" brightness'
